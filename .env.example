# Server Configuration
NODE_ENV=production
PORT=3001

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/rukabet?retryWrites=true&w=majority

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin Token for dashboard access
ADMIN_TOKEN=your-admin-token-change-this

# Admin credentials used by Admin Dashboard username/password login.
# Optional only if you use token-based admin auth instead.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# Frontend URL (for CORS in production)
FRONTEND_URL=https://your-app.herokuapp.com
# Public app URL used to build webhook URL logs
PUBLIC_APP_URL=https://your-app.herokuapp.com

# Payment Gateway (Configured directly in Admin Dashboard > Gateway tab - no Heroku env vars required!)
# Optional environment fallbacks if database settings are not initialized:
# PAYD_WALLET_USERNAME=your_payd_username
# PAYD_API_USERNAME=your_api_username
# PAYD_API_PASSWORD=your_api_password
# PAYD_API_BASE_URL=https://api.mypayd.app/api/v2/payments
# PAYD_CALLBACK_URL=https://your-app.herokuapp.com/api/webhooks/payd
