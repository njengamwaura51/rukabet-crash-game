# Server Configuration
NODE_ENV=production
PORT=3001

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/rukabet?retryWrites=true&w=majority

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin Token for dashboard access
ADMIN_TOKEN=your-admin-token-change-this

# Optional simple admin login credentials (used by Admin Dashboard login form)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# Frontend URL (for CORS in production)
FRONTEND_URL=https://your-app.herokuapp.com

# IntaSend API Keys (set via Admin Dashboard or env vars)
# INTASEND_PUBLIC_KEY=ISPubKey_live_xxx
# INTASEND_SECRET_KEY=ISSecretKey_live_xxx
