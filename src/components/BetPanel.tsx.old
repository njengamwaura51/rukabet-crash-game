import { useState, useEffect } from 'react'

// Betting state machine states
type BetState = 'IDLE' | 'QUEUED' | 'ACTIVE' | 'CASHED_OUT'

interface BetPanelProps {
  panelId: number
  defaultAmount?: number
  currency?: string
  phase: string
  multiplier: number
  onBet: (panelId: number, amount: number, isQueued?: boolean) => boolean
  onCashout: (panelId: number) => { success: boolean; multiplier?: number; amount?: number }
  onCancelQueue?: (panelId: number) => void
  activeBet?: { panelId: number; amount: number; cashedOut: boolean; won: number; isFreebet?: boolean }
  isLoggedIn?: boolean
  betMode?: 'money' | 'freebet'
  maxBet?: number
  autoBetEnabled?: boolean
  onAutoBetToggle?: (enabled: boolean) => void
}

const QUICK_AMOUNTS = [10, 100, 1000, 10000] as const
const STEP = 5
const MIN_AMOUNT = 10

// Toggle Switch Component
function ToggleSwitch({ 
  enabled, 
  onToggle, 
  disabled = false 
}: { 
  enabled: boolean
  onToggle: () => void
  disabled?: boolean 
}) {
  return (
    <button
      type="button"
      onClick={onToggle}
      disabled={disabled}
      className={`relative w-10 h-5 rounded-full transition-colors focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed ${
        enabled ? 'bg-[#00C74D]' : 'bg-[#374151]'
      }`}
    >
      <span
        className={`absolute top-0.5 left-0.5 w-4 h-4 bg-white rounded-full shadow transition-transform ${
          enabled ? 'translate-x-5' : 'translate-x-0'
        }`}
      />
    </button>
  )
}

export default function BetPanel({
  panelId,
  defaultAmount = 10,
  currency = 'KSH',
  phase,
  multiplier,
  onBet,
  onCashout,
  onCancelQueue,
  activeBet,
  isLoggedIn = false,
  maxBet = 0,
  autoBetEnabled = false,
  onAutoBetToggle,
}: BetPanelProps) {
  const [amount, setAmount] = useState(defaultAmount)
  const [autoCashout, setAutoCashout] = useState('2.00')
  const [autoCashoutEnabled, setAutoCashoutEnabled] = useState(false)
  const [betState, setBetState] = useState<BetState>('IDLE')
  const [queuedAmount, setQueuedAmount] = useState(0)
  const [lastBetAmount, setLastBetAmount] = useState(0)

  // Handle manual amount input
  const handleAmountChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const val = e.target.value.replace(/[^0-9]/g, '')
    const numVal = parseInt(val, 10)
    if (!isNaN(numVal)) {
      setAmount(Math.min(numVal, maxBet || 999999))
    } else if (val === '') {
      setAmount(0)
    }
  }

  const decrease = () => setAmount((prev) => Math.max(MIN_AMOUNT, Number((prev - STEP).toFixed(2))))
  const increase = () => setAmount((prev) => Math.min(maxBet || 999999, Number((prev + STEP).toFixed(2))))

  // Reset bet state when new round starts
  useEffect(() => {
    if (phase === 'waiting') {
      if (betState === 'QUEUED' && queuedAmount > 0) {
        const success = onBet(panelId, queuedAmount, false)
        if (success) {
          setBetState('ACTIVE')
          setLastBetAmount(queuedAmount)
        } else {
          setBetState('IDLE')
        }
        setQueuedAmount(0)
      } else if (betState === 'CASHED_OUT' || betState === 'ACTIVE') {
        if (autoBetEnabled && lastBetAmount >= MIN_AMOUNT && isLoggedIn) {
          const success = onBet(panelId, lastBetAmount, false)
          if (success) {
            setBetState('ACTIVE')
          } else {
            setBetState('IDLE')
          }
        } else {
          setBetState('IDLE')
        }
      }
    }
  }, [phase, betState, queuedAmount, panelId, onBet, autoBetEnabled, lastBetAmount, isLoggedIn])

  // Track active bet state
  useEffect(() => {
    if (activeBet && !activeBet.cashedOut && phase === 'flying') {
      setBetState('ACTIVE')
    } else if (activeBet?.cashedOut) {
      setBetState('CASHED_OUT')
    }
  }, [activeBet, phase])

  // Handle auto cashout
  useEffect(() => {
    if (autoCashoutEnabled && activeBet && phase === 'flying' && autoCashout && betState === 'ACTIVE') {
      const target = parseFloat(autoCashout)
      if (!isNaN(target) && multiplier >= target) {
        onCashout(panelId)
        setBetState('CASHED_OUT')
      }
    }
  }, [multiplier, phase, activeBet, autoCashout, autoCashoutEnabled, panelId, onCashout, betState])

  const handleClick = () => {
    if (!isLoggedIn) return

    if (betState === 'ACTIVE' && phase === 'flying') {
      const result = onCashout(panelId)
      if (result.success) {
        setBetState('CASHED_OUT')
      }
    } else if (betState === 'QUEUED') {
      if (onCancelQueue) {
        onCancelQueue(panelId)
      }
      setBetState('IDLE')
      setQueuedAmount(0)
    } else if (betState === 'IDLE') {
      const betAmount = Math.min(amount, maxBet || amount)
      if (betAmount < MIN_AMOUNT) return

      if (phase === 'waiting') {
        const success = onBet(panelId, betAmount, false)
        if (success) {
          setBetState('ACTIVE')
          setLastBetAmount(betAmount)
        }
      } else if (phase === 'flying' || phase === 'crashed') {
        const success = onBet(panelId, betAmount, true)
        if (success) {
          setBetState('QUEUED')
          setQueuedAmount(betAmount)
        }
      }
    }
  }

  // Determine button state and appearance
  const potentialWin = activeBet ? (activeBet.amount * multiplier).toFixed(2) : '0.00'

  let buttonText = 'BET'
  let buttonSubtext = `${amount.toFixed(2)} ${currency}`
  let buttonBg = '#00C74D'
  let isDisabled = false

  if (!isLoggedIn) {
    buttonText = 'BET'
    buttonSubtext = `${amount.toFixed(2)} ${currency}`
    buttonBg = '#00C74D'
  } else if (betState === 'QUEUED') {
    buttonText = 'CANCEL'
    buttonSubtext = `Next Round`
    buttonBg = '#ef4444'
  } else if (betState === 'ACTIVE' && phase === 'flying') {
    buttonText = 'CASH OUT'
    buttonSubtext = `${potentialWin} ${currency}`
    buttonBg = '#f59e0b'
  } else if (betState === 'CASHED_OUT') {
    buttonText = 'WAIT'
    buttonSubtext = 'Next Round'
    buttonBg = '#374151'
    isDisabled = true
  } else if (phase === 'crashed' || phase === 'crashing') {
    buttonText = 'BET NEXT'
    buttonSubtext = `${amount.toFixed(2)} ${currency}`
    buttonBg = '#00C74D'
  }

  return (
    <div className="bg-[#1a1d24] rounded-xl p-3 border border-white/5 flex flex-col gap-3">
      {/* Upper Section: Two-column grid (60% inputs, 40% button) */}
      <div className="flex gap-3">
        {/* Left Column: Inputs (60%) */}
        <div className="flex-[3] flex flex-col gap-2">
          {/* Amount stepper - dark pill container */}
          <div className="flex items-center bg-[#0f1318] rounded-full p-1">
            <button
              type="button"
              onClick={decrease}
              disabled={betState !== 'IDLE' || !isLoggedIn}
              className="w-9 h-9 rounded-full bg-[#252a33] flex items-center justify-center text-[#00C74D] text-xl font-black hover:bg-[#374151] active:scale-95 transition-all flex-shrink-0 disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none"
            >
              −
            </button>
            <input
              type="text"
              inputMode="numeric"
              pattern="[0-9]*"
              value={amount.toLocaleString()}
              onChange={handleAmountChange}
              disabled={betState !== 'IDLE' || !isLoggedIn}
              className="flex-1 bg-transparent text-center font-mono text-lg font-black text-white truncate focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
            />
            <button
              type="button"
              onClick={increase}
              disabled={betState !== 'IDLE' || !isLoggedIn}
              className="w-9 h-9 rounded-full bg-[#252a33] flex items-center justify-center text-[#00C74D] text-xl font-black hover:bg-[#374151] active:scale-95 transition-all flex-shrink-0 disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none"
            >
              +
            </button>
          </div>

          {/* Quick bet buttons - 4 column grid */}
          <div className="grid grid-cols-4 gap-1.5">
            {QUICK_AMOUNTS.map((v) => (
              <button
                key={v}
                type="button"
                onClick={() => setAmount(Math.min(v, maxBet || v))}
                disabled={betState !== 'IDLE' || !isLoggedIn}
                className="h-8 rounded-lg bg-[#0f1318] text-[11px] font-mono font-bold text-white/70 hover:bg-[#252a33] hover:text-white transition-all disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none"
              >
                {v >= 1000 ? `${v / 1000}k` : v}
              </button>
            ))}
          </div>
        </div>

        {/* Right Column: BET Button (40%) - spans full height */}
        <button
          type="button"
          onClick={handleClick}
          disabled={isDisabled}
          style={{ backgroundColor: buttonBg }}
          className="flex-[2] min-w-[100px] flex flex-col items-center justify-center rounded-xl hover:brightness-110 active:scale-[0.98] transition-transform disabled:opacity-60 disabled:cursor-not-allowed focus:outline-none"
        >
          <span className="text-xl font-black text-white tracking-wide">{buttonText}</span>
          <span className="text-xs font-bold text-white/90 font-mono mt-0.5">
            {buttonSubtext}
          </span>
        </button>
      </div>

      {/* Lower Section: Auto controls - full width row */}
      <div className="flex items-center justify-between bg-[#0f1318] rounded-lg px-3 py-2">
        {/* Auto Bet */}
        <div className="flex items-center gap-2">
          <span className="text-xs text-gray-400 font-medium">Auto Bet</span>
          <ToggleSwitch
            enabled={autoBetEnabled}
            onToggle={() => onAutoBetToggle?.(!autoBetEnabled)}
            disabled={!isLoggedIn}
          />
        </div>

        {/* Divider */}
        <div className="w-px h-5 bg-white/10" />

        {/* Auto Cash Out */}
        <div className="flex items-center gap-2">
          <span className="text-xs text-gray-400 font-medium">Auto Cash Out</span>
          <ToggleSwitch
            enabled={autoCashoutEnabled}
            onToggle={() => setAutoCashoutEnabled(!autoCashoutEnabled)}
            disabled={!isLoggedIn}
          />
          <div className="flex items-center bg-[#1a1d24] rounded-md border border-white/10 overflow-hidden">
            <input
              type="text"
              value={autoCashout}
              onChange={(e) => {
                const val = e.target.value.replace(/[^0-9.]/g, '')
                setAutoCashout(val)
              }}
              disabled={!autoCashoutEnabled || !isLoggedIn}
              className="w-12 h-6 bg-transparent text-white text-xs font-mono font-bold text-center focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed"
            />
            <span className="text-xs text-gray-400 font-bold pr-2">x</span>
          </div>
        </div>
      </div>
    </div>
  )
}
